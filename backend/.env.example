DATABASE_URL=postgresql+asyncpg://aero:aero@localhost:5432/aeroinsights
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

ENVIRONMENT=local
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Auth0 — fill in your tenant details
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://api.aeroinsights.io

# AWS (eu-west-1 — Dublin)
AWS_REGION=eu-west-1
AWS_S3_BUCKET=aeroinsights-exports
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Email
POSTMARK_API_TOKEN=
EMAIL_FROM=noreply@aeroinsights.io
