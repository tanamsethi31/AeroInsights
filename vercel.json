{
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "rm -rf node_modules && npm install",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)",     "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/alerts",            "schedule": "0 5 * * *"  },
    { "path": "/api/cron/watchlist",         "schedule": "30 5 * * *" },
    { "path": "/api/cron/fx-refresh",        "schedule": "0 6 * * *"  },
    { "path": "/api/cron/news-signals",      "schedule": "30 6 * * *" },
    { "path": "/api/cron/scheduled-reports", "schedule": "0 7 * * *"  }
  ]
}
