{
  "framework": "vite",
  "buildCommand": "npm run build",
  "installCommand": "rm -rf node_modules && npm install",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)",     "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/cron/alerts", "schedule": "*/30 * * * *" }
  ]
}
