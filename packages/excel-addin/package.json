{
  "name": "@aerinsights/excel-addin",
  "version": "1.0.0",
  "description": "Aeroinsights Excel Add-in — 20 custom AER.* worksheet functions with task pane",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts",
    "build": "vite build",
    "preview": "vite preview --port 3100",
